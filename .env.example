# ============================================================
# Pantheon OS — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ── Anthropic (ZEUS LLM reasoning) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (Postgres + pgvector + Realtime) ─────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # Backend only — full DB access
SUPABASE_ANON_KEY=eyJ...                  # Frontend (read-only via RLS)

# Supabase direct Postgres connection (for Grafana datasource)
# Get from: Supabase Dashboard → Settings → Database → Connection string
SUPABASE_DB_HOST=db.YOUR_PROJECT_ID.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD     # same as Supabase project password

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=choose_a_strong_password

# ── Upstash Redis (SpendLens bridge — zeus:* keys) ────────────
# Get from: Upstash Console → Redis → REST API
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ── Hermes API (live market signals) ──────────────────────────
HERMES_API_KEY=
HERMES_BASE_URL=https://hermes-agent-production-114e.up.railway.app

# ── Interactive Brokers ───────────────────────────────────────
IB_USERNAME=your_ibkr_username        # maps to TWS_USERID in ibgateway container
IB_PASSWORD=your_ibkr_password        # maps to TWS_PASSWORD in ibgateway container
IB_HOST=ibgateway                         # Docker service name in prod; 127.0.0.1 for local
IB_PORT=4002                              # 4002=paper (IB Gateway), 4001=live
IB_CLIENT_ID=1
# IBC behaviour when another IBKR session is already active:
#   primary   = take over (kick the other session) — use for unattended server
#   secondary = connect alongside the other session
EXISTING_SESSION_DETECTED_ACTION=primary

# ── Execution venue ───────────────────────────────────────────
# ibkr (default, IB Gateway above) | ctrader (IC Markets EU via cTrader Open API).
# Also selects the SIGNAL universe: ibkr → stock signals (Supabase/EDGAR/Finnhub),
# ctrader → FX/index technical setups (core/fx_signals.py, yfinance bars).
# With mock_execution=true no broker/credentials are used, but BROKER=ctrader
# still switches to FX/index signals and simulated risk sizing.
BROKER=ibkr

# ── cTrader Open API (only when BROKER=ctrader) ───────────────
# 1. Register an application at https://openapi.ctrader.com (Applications → Add).
#    The app must be APPROVED by Spotware (status "Active") before it can connect.
# 2. Client ID / Secret: shown on the app's page once approved.
# 3. Access + refresh token: run the OAuth flow with scope=trading
#    (https://openapi.ctrader.com/apps/auth?client_id=...&redirect_uri=...&scope=trading)
#    or use the app's "Playground" button. Access tokens expire after ~30 days; the
#    adapter refreshes them in memory and logs a warning: copy the new values here.
# 4. Account ID = ctidTraderAccountId (NOT the login number). The Playground /
#    ProtoOAGetAccountListByAccessTokenReq lists it; the smoke test prints a masked hint.
# Hosts: demo → demo.ctraderapi.com:5035, live → live.ctraderapi.com:5035 (SSL).
# Default is demo. Paper mode ALWAYS uses demo, even if CTRADER_ENV=live.
# NEVER commit real values.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_ENV=demo
# Optional: access-token expiry (unix seconds or ISO date) → proactive refresh 3 days early.
CTRADER_TOKEN_EXPIRES_AT=
# Smoke test (scripts/ctrader_smoke_test.py) refuses CTRADER_ENV=live unless this is "yes".
CTRADER_SMOKE_ALLOW_LIVE=
# Equity (EUR) used for cTrader risk sizing + milestone gate. Overrides
# default_account_equity (4000, kept for IBKR) ONLY when BROKER=ctrader.
# Example for a small demo account: CTRADER_ACCOUNT_EQUITY=500
# Risk per trade / min-lot tolerance / open-risk cap live in config/settings.py
# under "ctrader" (risk_per_trade_pct=0.01, max_min_lot_risk_overshoot=1.5,
# max_open_risk_pct=0.03). FX/index signal rules: "ctrader_signals".
CTRADER_ACCOUNT_EQUITY=
# Optional trade management on the cTrader path — ALL OFF by default. Leave empty
# to use settings.json; "true"/"false" overrides the matching "enabled" flag.
# Strategy knobs (ATR multiple, activation R, max adds, ramp thresholds ...) live in
# config/settings.py: ctrader_signals.<breakout|mean_reversion>.trailing_stop /
# .pyramiding and ctrader.risk_ramp. Paper/demo only until you have evaluated them.
CTRADER_TRAILING_BREAKOUT=
CTRADER_TRAILING_MEAN_REVERSION=
CTRADER_PYRAMID_BREAKOUT=
CTRADER_PYRAMID_MEAN_REVERSION=
CTRADER_RISK_RAMP=

# ── Telegram Alerts ───────────────────────────────────────────
# Get from: @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── FRED API (macro data — free) ──────────────────────────────
# Get from: fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── SEC EDGAR (historical ingestion) ──────────────────────────
# EDGAR requires a User-Agent with contact info (their terms of use)
# Use your email or a project contact address
EDGAR_USER_AGENT=your-email@example.com

# ── Hades compliance blocklist extensions (optional, comma-separated) ─
# HADES_OFAC_BLOCKLIST=GAZPROM,VTB                  # appended to built-in list
# HADES_ESG_BLOCKLIST=gambling,fur                  # appended to built-in list
# HADES_BLOCKED_TICKERS=RBLX,GME                   # hard-blocked tickers

# ── Tuning knobs (optional — defaults shown) ──────────────────
PYTHIA_MIN_SAMPLES=10           # minimum trades before using observed hit rate
PYTHIA_DEFAULT_SIZE_PCT=0.02    # fallback position size when no history
PYTHIA_MIN_CONFIDENCE=0.45      # minimum pattern confidence to pass sizing
APOLLO_ARXIV_MAX_PAPERS=5       # papers fetched per arXiv category per cycle
APOLLO_SELF_IMPROVE_N=50        # decision traces analysed per self-improvement run

# ── API Security ──────────────────────────────────────────────
# Shared secret for POST /run /halt /resume. Unset = auth disabled (local dev).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ZEUS_API_KEY=

# ── Hetzner server (for deploy scripts) ───────────────────────
HETZNER_SERVER_IP=YOUR_SERVER_IP
HETZNER_SSH_KEY=~/.ssh/id_rsa

# ── GitHub Container Registry (for CI/CD image push) ──────────
GHCR_TOKEN=ghp_...                        # GitHub PAT with write:packages scope

# ── Production domain ─────────────────────────────────────────
PRODUCTION_DOMAIN=pantheon.yourdomain.com

# ── Dashboard (Cloudflare Pages env vars — prefix VITE_) ──────
# Set these in Cloudflare Pages dashboard, NOT in this file
# VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_WS_URL=wss://pantheon.yourdomain.com/ws
# VITE_API_URL=https://pantheon.yourdomain.com/api
